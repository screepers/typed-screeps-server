{
	"name": "typed-screeps-server",
	"version": "0.0.6",
	"description": "Typescript types for the Screeps private server",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts"
		},
		"./renderer": {
			"types": "./dist/renderer.d.ts"
		}
	},
	"typesVersions": {
		"*": {
			"renderer": [
				"dist/renderer.d.ts"
			]
		}
	},
	"files": [
		"dist/**"
	],
	"keywords": [
		"Screeps",
		"API",
		"Typescript",
		"Autocomplete"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:watch": "tsc -p tsconfig.json --watch",
		"format": "prettier --write 'src/**/*.ts' README.md package.json tsconfig.json .prettierrc.yml",
		"test": "npm run build && tsc -p test/tsconfig.json && tsc -p test/tsconfig.no-pixi.json && npm run lint",
		"lint": "eslint -c eslint.config.mjs"
	},
	"author": "Etienne Samson <samson.etienne@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/screepers/typed-screeps-server.git"
	},
	"devDependencies": {
		"@types/express": "^4.11.1",
		"@types/lodash": "^3.10.9",
		"@types/node": "^24.13.3",
		"@types/pixi.js": "^4.8.9",
		"@types/q": "^1.5.8",
		"@types/screeps": "^3.3.8",
		"eslint": "^9.7.0",
		"eslint-plugin-expect-type": "^0.4.0",
		"husky": "^7.0.4",
		"isolated-vm": "^6.0.2",
		"lint-staged": "^12.3.8",
		"prettier": "^3.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"dependencies": {
		"lodash": "^3.10.1",
		"q": "^1.5.1"
	},
	"peerDependencies": {
		"@types/express": "^4.11.1",
		"@types/pixi.js": "^4.8.9",
		"@types/q": "^1.5.8",
		"@types/screeps": "^3.3.8",
		"isolated-vm": "^6.0.2"
	},
	"peerDependenciesMeta": {
		"@types/express": {
			"optional": true
		},
		"@types/pixi.js": {
			"optional": true
		},
		"isolated-vm": {
			"optional": true
		}
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write"
		]
	}
}
